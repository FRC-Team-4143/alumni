# Slack — DMs the graduation survey link and answers the /alumni slash command.
# Bot scopes needed: chat:write, im:write. The signing secret verifies inbound requests
# (the /alumni command only — there are no interactive components, no modal, so no
# Interactivity Request URL is needed, and Legion's slack_dispatch.py needs no entry
# for this app).
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# ── Legion — admin sign-in only, NOT a roster pull ──────────────────────────────
# /admin is gated by Legion's shared `mw_sso` cookie (needs `alumni-admin` or
# `alumni-manager` in Legion's /admin/groups). SSO_SECRET must match Legion's.
# LEGION_BASE_URL is only used to build the /sso/authorize redirect for staff sign-in.
# There is NO roster sync here — see LEGION_PUSH_API_KEY below for how people actually
# arrive in this app.
SSO_SECRET=must-match-legion-sso-secret
SSO_SESSION_TTL=43200
SSO_COOKIE_DOMAIN=
LEGION_BASE_URL=https://legion.example.org

# The reverse of a normal X-API-Key setup: Legion calls INTO this app, once, at the
# moment it archives a graduating senior (Legion's Yearly Grade Increase action). This
# is the shared secret Alumni checks on that inbound POST /api/graduates request — must
# match Legion's own ALUMNI_PUSH_API_KEY. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LEGION_PUSH_API_KEY=

# Signs the survey link every graduation DM carries — and the same person's permanent
# "update your info" link, meant to be dropped into a newsletter whenever one gets
# sent (there's still no *bulk* newsletter-sending feature here; you BYO mail-merge
# tool — see CLAUDE.md's "BYO email" section. SMTP below only covers self-service
# single-recipient recovery, /survey/find).
# Completely independent of SSO_SECRET above — it has to keep working for someone
# Legion no longer authenticates at all (a graduate is archived, and Legion's magic
# links refuse to redeem for an inactive member). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SURVEY_LINK_SECRET=
# How long an update link stays redeemable, in seconds. 0 (default) = never expires —
# deliberate, since the same link may sit in an admin's newsletter list for a year or
# more between sends. Set a positive value only if you specifically want links to age out.
SURVEY_LINK_TTL=0

# Database
DATABASE_URL=sqlite+aiosqlite:///./alumni.db

# Localisation
TIMEZONE=America/New_York

# Public base URL used in the survey DM's link and the /alumni command's reply.
# Production: https://alumni.marswars.org
BASE_URL=http://localhost:8003

# Days after the survey DM before a reminder DM goes out to anyone who hasn't answered.
# 0 (default) disables the reminder job entirely.
SURVEY_REMINDER_DAYS=0

# Database backups (SQLite only)
BACKUP_DIR=backups
BACKUP_KEEP=14
BACKUP_TIME=23:30
BACKUP_DAY=sun

# Master switch for automated Slack messages and scheduled jobs
UPDATES_ENABLED=true

# ── Outbound email — self-service "email me my update link" only ───────────────────
# Used by GET/POST /survey/find, for someone who read a plain identical BCC blast (no
# personal link in it) and/or has left Slack and has no other way back in. Works with
# any SMTP-capable provider: a real mailbox, Gmail with an app password, or a
# transactional API's SMTP endpoint. Blank SMTP_HOST = the feature is disabled
# (/survey/find still shows its generic response; nothing is sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=MARS/WARS Alumni

# Minimum seconds between self-service email sends for the same person, so one person
# can't hammer send. Independent of the admin Resend button's own bookkeeping.
SURVEY_FIND_COOLDOWN_SECONDS=300

# ── Public newsletter front page (/, /newsletters) ──────────────────────────────────
# Where uploaded newsletter PDFs are stored (see admin.py's "Newsletters" section).
# Deliberately under data/ (a persisted volume in production), not static/ (wiped on
# redeploy). Defaults are almost always fine; only override for local testing.
NEWSLETTER_DIR=data/newsletters
MAX_NEWSLETTER_MB=20
